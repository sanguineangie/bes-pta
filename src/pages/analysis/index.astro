---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Container from '@components/elements/Container.astro';
import Layout from '@layouts/Layout.astro';
import Sectionhead from '@components/elements/Sectionhead.astro';

type Post = CollectionEntry<'analysis'>;

const analysis = (await getCollection('analysis', ({ data }) => !data.draft))
  .sort((a: Post, b: Post) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

// Map status values to badge colors
function statusBadge(status: string) {
  switch (status?.toLowerCase()) {
    case 'supported':    return 'badge-success';
    case 'unsupported':  return 'badge-error';
    case 'inconclusive': return 'badge-warning';
    case 'in progress':  return 'badge-info';
    default:             return 'badge-neutral';
  }
}

function statusLabel(status: string) {
  switch (status?.toLowerCase()) {
    case 'unsupported': return "District explanation unsupported";
    case 'supported':   return "District explanation supported";
    default:            return status;
  }
}
---

<Layout title="Data & Analysis" description="All claims, conclusions, and supporting data.">
  <Container class="py-12 sm:py-16 lg:py-24">
    <Sectionhead eyebrow="Content">
      <Fragment slot="title">Data & Analysis</Fragment>
      <Fragment slot="desc">All claims, conclusions, and supporting data.</Fragment>
    </Sectionhead>

    <section class="mt-10 max-w-3xl">
      {analysis.length === 0 && (
        <div class="alert alert-info">
          <span>No posts yet. Add a Markdown file to <code>src/content/analysis/</code>.</span>
        </div>
      )}

      <ul class="flex flex-col gap-6">
        {analysis.map((post: Post) => (
          <li>
            <a
              href={`/analysis/${post.id}`}
              class="card border border-base-300 bg-base-100 transition-shadow hover:shadow-md"
            >
              <div class="card-body gap-2">

                <div class="flex flex-wrap items-center gap-2">
                  <span class={`badge badge-sm ${statusBadge(post.data.status)}`}>
                    {statusLabel(post.data.status)}
                  </span>
                  <time
                    datetime={post.data.publishedDate.toISOString()}
                    class="text-xs text-base-content/50"
                  >
                    {post.data.publishedDate.toLocaleDateString('en', {
                      year: 'numeric', month: 'long', day: 'numeric'
                    })}
                  </time>
                </div>

                <h2 class="card-title text-lg leading-snug">
                  {post.data.title}
                </h2>

                {post.data.description && (
                  <p class="text-sm text-base-content/70">{post.data.description}</p>
                )}

                {post.data.conclusion && (
                  <p class="text-sm text-base-content/60 italic">
                    Conclusion: {post.data.conclusion}
                  </p>
                )}

              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </Container>
</Layout>