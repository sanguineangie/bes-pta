---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Container from '@components/elements/Container.astro';
import Layout from '@layouts/Layout.astro';
import Sectionhead from '@components/elements/Sectionhead.astro';

type Post = CollectionEntry<'sources'>;

// Fetch all non-draft posts, newest first
const sources = (await getCollection('sources', ({ data }) => !data.draft))
  .sort((a: Post, b: Post) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---

<Layout title="sources" description="All posts">
  <Container class="py-12 sm:py-16 lg:py-24">
    <Sectionhead eyebrow="Content">
      <Fragment slot="title">Sources</Fragment>
      <Fragment slot="desc">Documents, audio, and video relevant to BES PTC.</Fragment>
    
    </Sectionhead>
    
    <section class="mt-10 max-w-3xl">
      {sources.length === 0 && (
        <div class="alert alert-info">
          <span>No posts yet. Add a Markdown file to <code>src/content/sources/</code>.</span>
        </div>
      )}

      <ul class="flex flex-col gap-6">
        {sources.map((sources: Post) => (
          <li>
            <a href={`/sources/${sources.id}`} class="card border border-base-300 bg-base-100 transition-shadow hover:shadow-md">
              <div class="card-body gap-3">
                <span class="badge badge-primary">{sources.data.category}</span>
                <h2 class="card-title">{sources.data.title}</h2>
                <p class="text-sm text-base-content/70">
                  <time datetime={sources.data.publishedDate.toISOString()}>
                    {sources.data.publishedDate.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </p>
                <p>{sources.data.description}</p>
              </div>
              
            </a>
          </li>
        ))}
      </ul>
    </section>
  </Container>
</Layout>